# Copy to .env and fill in. .env is git-ignored.
# Get a key at https://openrouter.ai/keys. Leave blank to use a local OpenAI-compatible server
# (e.g. llama.cpp on http://127.0.0.1:8081/v1).
OPENROUTER_API_KEY=

# Model roles: any id from https://openrouter.ai/models
# JUDGE: compares translations with the experiment's documented rubric
L10N_JUDGE_MODEL=anthropic/claude-sonnet-5.5
# MT: the translation model used in experiments
L10N_MT_MODEL=openai/gpt-5.4-mini
# Reasoning effort for models that "think" (none|minimal|low|medium|high)
L10N_REASONING_EFFORT=low

# Embeddings. Prefix "openrouter:" = hosted; no prefix = local sentence-transformers model.
L10N_RETRIEVAL_MODEL=openrouter:baai/bge-m3
# Extra retrievers to compare in benchmarks (comma-separated, optional)
L10N_EXTRA_RETRIEVAL_MODELS=openrouter:openai/text-embedding-3-large,openrouter:qwen/qwen3-embedding-8b

# Routing (semantic threshold is cosine × 100)
L10N_FUZZY_THRESHOLD=75
L10N_SEMANTIC_MIN_SIM=80

# Local alternative: install `uv sync --extra local`, run a model server, then set:
# L10N_LLM_BASE_URL=http://127.0.0.1:8081/v1
# L10N_LLM_MODEL=your-served-model-id
# L10N_RETRIEVAL_MODEL=BAAI/bge-m3

# Hugging Face read token for gated QE models (accept https://huggingface.co/Unbabel/wmt22-cometkiwi-da first)
HF_TOKEN=

# DeepL API key for the NMT control (free tier keys end in ":fx")
DEEPL_API_KEY=

# Direct OpenAI billing for the frontier replication
OPENAI_API_KEY=
